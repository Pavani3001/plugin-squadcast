{%- macro title(link, execution) -%}
*
{%- if link is defined -%}
<{{link}}|[{{execution.namespace}}] {{execution.flowId}} &rarr; {{execution.state.current}}>
{%- else -%}
[{{execution.namespace}}] {{execution.flowId}} &rarr; {{execution.state.current}}
    {%- endif -%}
*
{%- endmacro -%}
{
{% if message is defined %}
    "message": "{{message}}",
{% endif %}
{% if tags is defined %}
    "tags": {
{% for tag in tags %}
    {{ tag.key | toJson }} : {{ tag.value | toJson }},
{% endfor %}
        },
{% endif %}
     "description": {% filter toJson %}{{ title(link, execution) }}
Final task ID: {{lastTask.taskId}}
Status: {% if firstFailed == false %}Succeeded{% else %}Failed on task `{{firstFailed.taskId}}`{% endif %}
Duration: {{duration}}
{%- if customMessage is defined and customMessage is not empty %}
Message: {{ customMessage }}
{%- endif %}
{%- if customFields is defined and customFields is not empty %}
{%- for entry in customFields %}
{{ entry.key }}: {{ entry.value }}
{%- endfor %}
{%- endif %}{% endfilter %}
{% if eventId is defined %}
    ,"event_id": "{{eventId}}"
{% endif %}
}
