{%- macro title(link, execution) -%}
*
{%- if link is defined -%}
<{{link}}|[{{execution.namespace}}] {{execution.flowId}} &rarr; {{execution.state.current}}>
{%- else -%}
[{{execution.namespace}}] {{execution.flowId}} &rarr; {{execution.state.current}}
    {%- endif -%}
*
{%- endmacro -%}
{
{% if message is defined %}
    "message": "{{message}}",
{% endif %}
{% if tags is defined %}
    "tags": {
{% for tag in tags %}
    {{ tag.key | toJson }} : {{ tag.value | toJson }},
{% endfor %}
        },
{% endif %}
     "description": "{{ title(link, execution) }}\nFinal task ID: {{lastTask.taskId}}\nStatus: {% if firstFailed == false %}Succeeded{% else %}Failed on task `{{firstFailed.taskId}}`{% endif %}\nDuration: {{duration}}{% if customMessage is defined %}\nMessage: {{ customMessage | escapeChar('double') }}{% endif %}{% if customFields is defined and customFields is not empty %}{% for entry in customFields %}\n{{ entry.key | escapeChar('double') }}: {{ entry.value | escapeChar('double') }}{% endfor %}{% endif %}"
{% if eventId is defined %}
    ,"event_id": "{{eventId}}"
{% endif %}
}
